FROM rust:1-slim AS builder

WORKDIR /app

COPY sonia-emu/emulator/Cargo.toml sonia-emu/emulator/Cargo.lock ./

COPY sonia-emu/emulator/src ./src

RUN cargo build --release

FROM debian:bookworm-slim AS runtime

WORKDIR /app

ARG INPUT_GID
RUN groupadd -g ${INPUT_GID} input && \
    groupadd -r emu && \
    useradd -r -g emu -G input emu

COPY --from=builder --chown=emu:emu /app/target/release/sonia-emu .

USER emu

ENTRYPOINT ["./sonia-emu"]
